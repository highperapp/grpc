{
    "name": "highperapp/grpc",
    "description": "High-Performance gRPC Server with Rust FFI acceleration and pure PHP fallback",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "grpc",
        "server",
        "high-performance",
        "rust",
        "ffi",
        "amphp",
        "protobuf"
    ],
    "authors": [
        {
            "name": "HighPerApp Team",
            "email": "raghuveer.dendukuri@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3|^8.4",
        "amphp/parallel": "^2.0",
        "amphp/http-server": "^3.0",
        "amphp/socket": "^2.0",
        "google/protobuf": "^3.21",
        "psr/log": "^3.0",
        "ext-ffi": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "HighPerApp\\HighPer\\GRPC\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HighPerApp\\HighPer\\GRPC\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=\"Unit Tests\"",
        "test:integration": "phpunit --testsuite=\"Integration Tests\"",
        "test:performance": "phpunit --testsuite=\"Performance Tests\"",
        "test:concurrency": "phpunit --testsuite=\"Concurrency Tests\"",
        "test:reliability": "phpunit --testsuite=\"Reliability Tests\"",
        "test:coverage": "phpunit --coverage-html coverage-html",
        "cs-check": "phpcs --standard=PSR12 src tests",
        "cs-fix": "phpcbf --standard=PSR12 src tests"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}